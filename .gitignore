import streamlit as st

st.title("My App with Aim & Quiz")

# AIM SECTION
st.header("🎯 Your Aim")
aim = st.text_input("Enter your aim:")
if aim:
    st.success(f"Your aim is: {aim}")

# QUIZ SECTION
st.header("🧠 Quick Quiz")

question = "What is 2 + 2?"
options = ["2", "3", "4", "5"]
answer = st.radio(question, options)

if st.button("Submit Answer"):
    if answer == "4":
        st.success("Correct! 🎉")
    else:
        st.error("Wrong answer 😢")
