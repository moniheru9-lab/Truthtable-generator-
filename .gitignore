import streamlit as st

st.title("🔌 Digital Electronics Practice App")

# AIM SECTION
st.header("🎯 Aim of the Experiment")
st.write("""
To study and verify the truth table of basic logic gates like AND, OR, and NOT.
""")

user_aim = st.text_input("Write your understanding of the aim:")
if user_aim:
    st.success(f"Your Aim: {user_aim}")

# TRUTH TABLE DISPLAY
st.header("📊 AND Gate Truth Table")

st.table({
    "A": [0, 0, 1, 1],
    "B": [0, 1, 0, 1],
    "Output (A AND B)": [0, 0, 0, 1]
})

# QUIZ SECTION
st.header("🧠 Quiz on Truth Table")

score = 0

# Question 1
q1 = st.radio(
    "1. What is the output of AND gate when A=1 and B=1?",
    ["0", "1"],
    key="q1"
)

# Question 2
q2 = st.radio(
    "2. What is the output of OR gate when A=0 and B=1?",
    ["0", "1"],
    key="q2"
)

# Question 3
q3 = st.radio(
    "3. NOT gate inverts the input. What is output when input is 0?",
    ["0", "1"],
    key="q3"
)

if st.button("Submit Quiz"):
    if q1 == "1":
        score += 1
    if q2 == "1":
        score += 1
    if q3 == "1":
        score += 1

    st.success(f"Your Score: {score}/3 🎉")

    if score == 3:
        st.balloons()
